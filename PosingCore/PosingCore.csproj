<Project Sdk="Dalamud.NET.SDK/15.0.0">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Platforms>x64</Platforms>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>Poser</RootNamespace>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Use_DalamudPackager>false</Use_DalamudPackager>
	</PropertyGroup>

	<ItemGroup>
		<!-- Domain value types (PoseSlot) are shared so slot identity has ONE
		     representation across the transitional entities and the clean core. -->
		<ProjectReference Include="..\Poser.Domain\Poser.Domain.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Transitional runtime implementations now live in Poser.Game while
		     their native entity storage is migrated out of this assembly. -->
		<InternalsVisibleTo Include="Poser.Game" />
		<InternalsVisibleTo Include="PosingCore.Tests" />
		<!-- The scene transaction lives in Poser.Game; its tests build the
		     store's read/write outcomes directly. -->
		<InternalsVisibleTo Include="Poser.Game.Tests" />
		<EmbeddedResource Include="Data\GraphicalBones\GraphicalBonePosePositions.json" />
		<EmbeddedResource Include="Data\GraphicalBones\Images\*.png" />
		<EmbeddedResource Include="Data\Expressions\*.json" />
		<!-- Brio's embedded rest poses, byte-identical to its
		     Resources/Embedded/Data files so the two plugins land the exact
		     same A/T-pose. -->
		<EmbeddedResource Include="Data\RestPoses\*.pose" />
		<!-- Brio's bone-filter catalog, byte-identical to its
		     Resources/Embedded/Data/BoneCategories.json so the two plugins
		     agree bone-for-bone on what every category claims. -->
		<EmbeddedResource Include="Data\BoneCategories\*.json" />
	</ItemGroup>

</Project>
