<Project Sdk="Dalamud.NET.SDK/15.0.0">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Platforms>x64</Platforms>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>Poser.UI</RootNamespace>
		<AssemblyName>Poser.UI</AssemblyName>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Use_DalamudPackager>false</Use_DalamudPackager>
	</PropertyGroup>

	<!-- Release identity; rationale and dependency verdicts live in
	     THIRD-PARTY-LICENSES.md. -->
	<PropertyGroup>
		<Authors>Midona</Authors>
		<Copyright>Copyright (C) 2026 Midona</Copyright>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
	</PropertyGroup>


	<ItemGroup>
		<!-- Exclude nested build output from source globbing. -->
		<Compile Remove="Rendering\bin\**\*.cs;Rendering\obj\**\*.cs" />
	</ItemGroup>
</Project>
