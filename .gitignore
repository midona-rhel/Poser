## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml
/Brio/
/.claude/*
!/.claude/skills/
/claude
.claude/settings.local.json
CLAUDE.md

# Local ImGui artifacts
/imgui.ini
/tools/__pycache__/
/tools/uiverify/
/docs/validation/**/*.png
/PosingCore/Data/GameData/

# Release archives and diagnostic output
*.zip
/dist/
*.log
*.dmp
*.mdmp
*.core
*.etl

# The build-output rule `[Rr]elease/` above matches a directory of that name at
# ANY depth, so it swallows the release documentation as well. Re-include the
# directory itself; git will not descend into an excluded directory, so the
# negation has to name the directory, not the files under it.
!/docs/release/
.codex-branch-label/
.worktrees/
