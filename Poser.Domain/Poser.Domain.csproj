<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <!-- A switch expression that misses a named enum value does not build:
         SceneOutcomeKind's labels and remedies rely on it. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
  </PropertyGroup>

  <!-- Release identity; rationale and dependency verdicts live in
       THIRD-PARTY-LICENSES.md. -->
  <PropertyGroup>
    <Authors>Midona</Authors>
    <Copyright>Copyright (C) 2026 Midona</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

</Project>
