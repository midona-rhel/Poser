<Project Sdk="Dalamud.NET.SDK/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Poser.Game</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Use_DalamudPackager>false</Use_DalamudPackager>
  </PropertyGroup>

  <!-- Release identity; rationale and dependency verdicts live in
       THIRD-PARTY-LICENSES.md. -->
  <PropertyGroup>
    <Authors>Midona</Authors>
    <Copyright>Copyright (C) 2026 Midona</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Poser.Game.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The one allowed package for the MCDF legacy LZ4 stream (PBI-009). -->
    <PackageReference Include="K4os.Compression.LZ4.Legacy" Version="1.3.8" />
    <!-- The game-UI node library behind the overlay nodes (Poser.Game/Overlays).
         Pinned to the version Ktisis ships, which is the implementation those
         nodes are transcribed from. -->
    <PackageReference Include="KamiToolKit" Version="1.1.17" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Lighting\Data\gobos.csv" />
    <!-- Curated festival names, phases and area exclusions (Brio's data file). -->
    <EmbeddedResource Include="Data\Festivals.json" />
    <!-- Curated spawnable prop models: name + weapon model triple (Ktisis's
         community props library, Data/Library/props.json). -->
    <EmbeddedResource Include="Data\props.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Poser.Domain\Poser.Domain.csproj" />
    <ProjectReference Include="..\Poser.Application\Poser.Application.csproj" />
    <ProjectReference Include="..\PosingCore\PosingCore.csproj" />
    <InternalsVisibleTo Include="PosingCore.Tests" />
  </ItemGroup>
</Project>
