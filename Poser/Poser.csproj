<Project Sdk="Dalamud.NET.SDK/15.0.0">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Platforms>x64</Platforms>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>Poser</RootNamespace>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Version>0.0.0.1</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Poser.Domain\Poser.Domain.csproj" />
		<ProjectReference Include="..\Poser.Application\Poser.Application.csproj" />
		<ProjectReference Include="..\Poser.Game\Poser.Game.csproj" />
		<ProjectReference Include="..\PosingCore\PosingCore.csproj" />
		<ProjectReference Include="..\Poser.UI\Poser.UI.csproj" />
	</ItemGroup>

</Project>
