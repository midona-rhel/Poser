<Project Sdk="Dalamud.NET.SDK/15.0.0">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Platforms>x64</Platforms>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>Poser</RootNamespace>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<!-- A Dalamud manifest takes a four-part numeric AssemblyVersion, so
		     "beta" reads in the punchline and the changelog, never in the
		     version string. Keep this in lockstep with Poser.json's
		     AssemblyVersion. -->
		<Version>0.9.4.0</Version>
	</PropertyGroup>


  <ItemGroup>
    <Content Include="Data\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\Integration\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
	<!-- Branch identity is captured by the build, never discovered by the
	     plugin at runtime. CI may provide any of the conventional branch
	     variables; local builds fall back to the checked-out build branch. -->
	<PropertyGroup>
		<BuildBranch Condition="'$(BuildBranch)' == ''">$(GITHUB_HEAD_REF)</BuildBranch>
		<BuildBranch Condition="'$(BuildBranch)' == ''">$(GITHUB_REF_NAME)</BuildBranch>
		<BuildBranch Condition="'$(BuildBranch)' == ''">$(BUILD_SOURCEBRANCHNAME)</BuildBranch>
		<BuildBranch Condition="'$(BuildBranch)' == ''">$(SourceBranchName)</BuildBranch>
	</PropertyGroup>
	<Target Name="CaptureBuildBranch" BeforeTargets="CoreCompile">
		<Exec Condition="'$(BuildBranch)' == ''" Command="git branch --show-current" ConsoleToMSBuild="true" IgnoreExitCode="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="BuildBranch" />
		</Exec>
		<Exec Condition="'$(BuildCommit)' == ''" Command="git rev-parse --short=7 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="BuildCommit" />
		</Exec>
		<PropertyGroup>
			<!-- Branch names are untrusted input to generated source. Keep one
			     printable line, cap its size, and escape C# string delimiters. -->
			<BuildBranch>$([System.Text.RegularExpressions.Regex]::Replace('$(BuildBranch)', '[^ -~]', ''))</BuildBranch>
			<BuildBranch Condition="$([System.String]::Copy('$(BuildBranch)').Length) &gt; 128">$([System.String]::Copy('$(BuildBranch)').Substring(0, 128))</BuildBranch>
			<BuildBranch>$([System.String]::Copy('$(BuildBranch)').Replace('\', '\\').Replace('&quot;', '\&quot;'))</BuildBranch>
			<BuildCommit>$([System.Text.RegularExpressions.Regex]::Replace('$(BuildCommit)', '[^0-9A-Fa-f]', ''))</BuildCommit>
			<BuildCommit Condition="$([System.String]::Copy('$(BuildCommit)').Length) &gt; 7">$([System.String]::Copy('$(BuildCommit)').Substring(0, 7))</BuildCommit>
		</PropertyGroup>
		<ItemGroup>
			<BuildMetadataLine Include="namespace Poser { internal static class BuildMetadata { public const string Branch = &quot;$(BuildBranch)&quot;%3B public const string Commit = &quot;$(BuildCommit)&quot;%3B } }" />
		</ItemGroup>
		<WriteLinesToFile File="$(IntermediateOutputPath)BuildMetadata.g.cs" Overwrite="true" Encoding="UTF-8"
			Lines="@(BuildMetadataLine)" />
	</Target>
	<ItemGroup>
		<Compile Include="$(IntermediateOutputPath)BuildMetadata.g.cs" Visible="false" />
	</ItemGroup>

	<!-- Release identity. GPL-3.0-only, not -or-later: Poser derives from Ktisis
	     and Brio, both bare GPLv3 with no version-upgrade clause. Evidence and
	     the full dependency verdicts are in THIRD-PARTY-LICENSES.md. -->
	<PropertyGroup>
		<Authors>Midona</Authors>
		<Copyright>Copyright (C) 2026 Midona</Copyright>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
		<Description>A posing and scene tool for FINAL FANTASY XIV's group pose.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Poser.Domain\Poser.Domain.csproj" />
		<ProjectReference Include="..\Poser.Application\Poser.Application.csproj" />
		<ProjectReference Include="..\Poser.Game\Poser.Game.csproj" />
		<ProjectReference Include="..\PosingCore\PosingCore.csproj" />
		<ProjectReference Include="..\Poser.UI\Poser.UI.csproj" />
	</ItemGroup>

</Project>
